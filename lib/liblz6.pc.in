#   LZ6 - lossless compression library
#   Based on LZ4 by Yann Collet and LZ5 by Przemyslaw Skibinski (BSD 2-Clause License)

prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: lz6
Description: lossless compression library: fast LZ block and frame codecs and the seq engine (LZ match finder, FSE/rANS and Huffman literals)
URL: https://github.com/YadeWira/lz6
Version: @VERSION@
Libs: -L@LIBDIR@ -llz6
Libs.private: -lm
Cflags: -I@INCLUDEDIR@
