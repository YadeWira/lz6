diff --git a/bench/lz_codecs.cpp b/bench/lz_codecs.cpp
index 6556b40..66fbe28 100644
--- a/bench/lz_codecs.cpp
+++ b/bench/lz_codecs.cpp
@@ -84,6 +84,93 @@ int64_t lzbench_misa77_safe_decompress(char* inbuf, size_t insize, char* outbuf,
 
 
 
+#ifndef BENCH_REMOVE_LZ5
+#include "lz5/lz5.h"
+#include "lz5/lz5hc.h"
+
+// lz5 v1.5 (inikep, 2016) - the direct predecessor of lz6; block codec,
+// same convention as the lz4/lz4hc entries.
+int64_t lzbench_lz5_compress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    (void)codec_options;
+    return (int64_t)LZ5_compress_default(inbuf, outbuf, (int)insize, (int)outsize);
+}
+
+int64_t lzbench_lz5hc_compress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    return (int64_t)LZ5_compress_HC(inbuf, outbuf, (int)insize, (int)outsize, (int)codec_options->level);
+}
+
+int64_t lzbench_lz5_decompress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    (void)codec_options;
+    return (int64_t)LZ5_decompress_safe(inbuf, outbuf, (int)insize, (int)outsize);
+}
+#endif // BENCH_REMOVE_LZ5
+
+
+
+#ifndef BENCH_REMOVE_LZ6
+#include "lz6/lz6.h"
+#include "lz6/entropy/lz6seq.h"
+#include "lz6/lz6frame.h"
+
+// lz6 seq codec (levels 1..15) - the project's main engine. The encoder
+// needs dstCap >= LZ6_COMPRESSBOUND(srcSize) + 65536; lzbench's outbuf
+// has that margin (checked in lzbench_lz6_compress).
+int64_t lzbench_lz6_compress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    if (outsize < (size_t)LZ6_compressBound((int)insize) + 65536)
+        return 0;
+    return (int64_t)LZ6_compress_seq(inbuf, insize, outbuf, outsize, (int)codec_options->level);
+}
+
+int64_t lzbench_lz6_decompress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    (void)codec_options;
+    return (int64_t)LZ6_decompress_seq(inbuf, insize, outbuf, outsize);
+}
+
+// lz6 HC frame (levels 1..15) - the classic hash-chain parser inside the
+// .lz6 frame, kept for comparison against the seq engine.
+char* lzbench_lz6hc_init(size_t, size_t, size_t)
+{
+    LZ6F_decompressionContext_t* c = (LZ6F_decompressionContext_t*)malloc(sizeof(*c));
+    if (!c) return NULL;
+    if (LZ6F_isError(LZ6F_createDecompressionContext(c, LZ6F_VERSION))) { free(c); return NULL; }
+    return (char*)c;
+}
+
+void lzbench_lz6hc_deinit(char* work_mem)
+{
+    if (work_mem) {
+        LZ6F_freeDecompressionContext(*(LZ6F_decompressionContext_t*)work_mem);
+        free(work_mem);
+    }
+}
+
+int64_t lzbench_lz6hc_compress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    LZ6F_preferences_t prefs;
+    memset(&prefs, 0, sizeof(prefs));
+    prefs.compressionLevel = (int)codec_options->level;
+    prefs.autoFlush = 1;
+    size_t r = LZ6F_compressFrame(outbuf, outsize, inbuf, insize, &prefs);
+    return LZ6F_isError(r) ? 0 : (int64_t)r;
+}
+
+int64_t lzbench_lz6hc_decompress(char* inbuf, size_t insize, char* outbuf, size_t outsize, codec_options_t* codec_options)
+{
+    LZ6F_decompressionContext_t* c = (LZ6F_decompressionContext_t*)codec_options->work_mem;
+    size_t dout = outsize, din = insize;
+    if (!c) return 0;
+    if (LZ6F_isError(LZ6F_decompress(*c, outbuf, &dout, inbuf, &din, NULL))) return 0;
+    return (int64_t)dout;
+}
+#endif // BENCH_REMOVE_LZ6
+
+
+
 #ifndef BENCH_REMOVE_BRIEFLZ
 #include "lz/brieflz/brieflz.h"
 
