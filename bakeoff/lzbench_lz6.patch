+# lz5 v1.5 (inikep, 2016) - predecessor of lz6, block codec.
+LZ5_DIR = lz/lz5
+LZ5_INC = -I$(LZ5_DIR) -DXXH_NAMESPACE=LZ5_
+LZ5_FILES = $(LZ5_DIR)/lz5.o $(LZ5_DIR)/lz5hc.o $(LZ5_DIR)/xxhash.o
+
+$(LZ5_DIR)/%.o: $(LZ5_DIR)/%.c
+	@$(MKDIR) $(dir $@)
+	$(CC) $(CFLAGS_O2) $(LZ5_INC) $< -c -o $@
+
+# lz6 (YadeWira/lz6) - add via -DLZ6_DIR=<path to a lz6 checkout>; the sources
+# are copied into lz/lz6 so no external path is needed by default.
+LZ6_DIR = lz/lz6
+LZ6_INC = -I$(LZ6_DIR) -I$(LZ6_DIR)/entropy -DXXH_NAMESPACE=LZ6_
+LZ6_FILES  = $(LZ6_DIR)/lz6.o $(LZ6_DIR)/lz6hc.o $(LZ6_DIR)/lz6frame.o $(LZ6_DIR)/xxhash.o
+# The seq entropy coders (fse/seq/huf) miscompile under -O3 -> build them at -O2.
+LZ6_FILES += $(LZ6_DIR)/entropy/lz6fse.o $(LZ6_DIR)/entropy/lz6rc.o $(LZ6_DIR)/entropy/lz6seq.o $(LZ6_DIR)/entropy/lz6huf.o
+
+$(LZ6_DIR)/%.o: $(LZ6_DIR)/%.c
+	@$(MKDIR) $(dir $@)
+	$(CC) $(CFLAGS) $(LZ6_INC) $< -c -o $@
+
+$(LZ6_DIR)/entropy/%.o: $(LZ6_DIR)/entropy/%.c
+	@$(MKDIR) $(dir $@)
+	$(CC) $(CFLAGS_O2) $(LZ6_INC) $< -c -o $@
+
